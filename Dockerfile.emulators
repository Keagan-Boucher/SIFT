FROM node:20-slim

# firebase-tools 15 requires JDK 21 or newer for the Firestore and Auth
# emulators. Debian bookworm ships 17, so Java comes from Adoptium instead.
RUN apt-get update \
    && apt-get install -y --no-install-recommends wget gnupg ca-certificates \
    && wget -qO- https://packages.adoptium.net/artifactory/api/gpg/key/public \
       | gpg --dearmor > /etc/apt/trusted.gpg.d/adoptium.gpg \
    && echo "deb https://packages.adoptium.net/artifactory/deb bookworm main" \
       > /etc/apt/sources.list.d/adoptium.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends temurin-21-jre \
    && apt-get purge -y wget gnupg \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g firebase-tools

# Dependencies are installed inside the image, and docker-compose masks the
# host's node_modules over the mount, so a Windows install never leaks into Linux.
WORKDIR /workspace/functions
COPY functions/package.json functions/package-lock.json* ./
RUN npm install

# node:20-slim ships none of the shared libraries headless Chromium needs
# (libnspr4, libnss3, libatk, ...): it launches, then fails at the dynamic
# linker before Playwright gets a connection to it. install-deps installs the
# exact package list for whatever Debian release the image is on, version-
# pinned to match the playwright-core in package.json so the dependency table
# is for the right Chromium build. This does not download a browser itself:
# @sparticuz/chromium supplies the binary, this only supplies its libraries.
RUN npx --yes playwright@1.62.1 install-deps chromium \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
