# Copy to .env.local. With these blank, SIFT runs on its seeded demo dataset
# instead of failing at launch, so the app is still demoable with no project.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Point the app at the Firebase Emulator Suite from docker-compose instead of
# the real project. Leave unset for a cloud build.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false
