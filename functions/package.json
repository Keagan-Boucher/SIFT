{
  "name": "functions",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --require ts-node/register --test src/extraction/__tests__/extraction.test.ts src/resolution/__tests__/resolution.test.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.2",
    "p-limit": "^3.1.0",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
