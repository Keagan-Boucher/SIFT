rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if owns(userId);
    }

    // The client creates a search and then subscribes to it. Everything after
    // creation is written by the pipeline through the admin SDK, so the client
    // may only delete its own searches, never edit one mid-run.
    match /searches/{searchId} {
      allow read, delete: if owns(resource.data.userId);
      allow create: if owns(request.resource.data.userId)
                    && request.resource.data.query is string
                    && request.resource.data.query.size() > 0
                    && request.resource.data.status == 'pending';
      allow update: if false;
    }

    // Listings are readable by the owner of their parent search only. Writes
    // come from Cloud Functions, including the confirm-matches callable.
    match /listings/{listingId} {
      allow read: if signedIn()
                  && get(/databases/$(database)/documents/searches/$(resource.data.searchId)).data.userId == request.auth.uid;
      allow write: if false;
    }

    // A watched search, plus the price history the dashboard reads back.
    match /savedSearches/{savedId} {
      allow read, delete: if owns(resource.data.userId);
      allow create, update: if owns(request.resource.data.userId);

      match /pricePoints/{pointId} {
        allow read: if owns(get(/databases/$(database)/documents/savedSearches/$(savedId)).data.userId);
        allow write: if false;
      }
    }

    // The shared registry. Readable by any signed-in user because that is the
    // point of write-back: a site solved once is solved for everyone after.
    match /retailerTemplates/{domain} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
